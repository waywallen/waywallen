<?xml version="1.0" encoding="UTF-8"?>
<!--
  waywallen-display-v1, protocol version 9

  Wire protocol between a display consumer and the waywallen daemon over
  SOCK_STREAM Unix Domain Socket at $XDG_RUNTIME_DIR/waywallen/display.sock.

  Role model:
    client = passive display consumer. It owns display identity, current
             surface metrics, window facts, input facts, GPU import
             capabilities and completion acknowledgements.
    server = daemon manager. It owns routing, renderer lifecycle, buffer
             negotiation, composition, presentation effects and recovery.

  Wire format:
    header = u16 opcode + u16 total byte length, little-endian.
    body   = positional, 4-byte aligned values generated from this schema.
    fds    = SCM_RIGHTS ancillary data in the order documented per event.

  Connection contract:
    - `hello` is the first request and `welcome` is the first reply.
    - The daemon accepts exactly protocol v9 and rejects other versions
      before reading registration capabilities or creating router state.
    - Every protocol refusal that can still be written to the peer is answered
      with `error` before the connection closes. An undecodable handshake frame
      includes the accepted version range in that error.
    - `register_display` is sent exactly once after `welcome` and contains
      every consumer-owned fact required for initial routing.
    - `display_accepted` is the first event after registration. Its
      presentation snapshot reflects the fully reconciled initial state.
    - Backends and consumer capabilities are immutable for a connection;
      changing GPU/backend requires reconnecting.

  Generation contract:
    - buffer_generation is connection-local and strictly increasing.
    - composition generation is strictly increasing and every composition
      explicitly names its buffer_generation.
    - frame seq is connection-local and strictly increasing across binds.
    - presentation config/state generations are connection-local; a state
      names the config generation it was resolved against.

  Buffer/release contract:
    - `bind_buffers` atomically carries one pool and its initial composition.
    - `bind_buffers.transition` is set only when the pool shows different
      wallpaper content than the one it replaces and the current
      presentation config names a transition kind. The consumer keeps the
      content it last presented and animates from it to the pool's first
      presented frame.
    - A later `set_composition_config` may only target the current pool.
    - `frame_ready` carries acquire sync_file then release syncobj fds.
    - The consumer attaches or signals the release fence, then sends
      `frame_release_armed`. GPU completion is observed from the syncobj.
    - `ack_unbind` only confirms host-side teardown ownership transfer; it
      is not GPU completion.
    - No buffer_release request exists.

  Coordinates:
    - DisplayMetrics and pointer x/y use actual surface-local coordinates,
      after physical output rotation, independent of wallpaper transform.
    - Composition source_rect is texture space and dest_rect is display
      surface space. The daemon owns inverse pointer mapping.

  Removed development messages keep their request opcodes reserved:
    4 = historical buffer_release, 5 = bye, 6 = consumer_caps.
-->
<protocol name="waywallen_display" version="9">

  <!-- ==================================================================
       SHARED ENUMS AND STRUCTURES
       ================================================================== -->

  <enum name="pause_effect_kind">
    <entry name="none" value="0"/>
    <entry name="blur" value="1"/>
  </enum>

  <enum name="transition_kind">
    <entry name="none" value="0"/>
    <entry name="fade" value="1"/>
    <entry name="wipe" value="2"/>
    <entry name="grow" value="3"/>
  </enum>

  <enum name="buffer_import_failure_kind">
    <entry name="unsupported" value="0"/>
    <entry name="resource_exhausted" value="1"/>
    <entry name="backend_failure" value="2"/>
  </enum>

  <enum name="pointer_button_state">
    <entry name="released" value="0"/>
    <entry name="pressed" value="1"/>
  </enum>

  <enum name="pointer_axis_source">
    <entry name="wheel" value="0"/>
    <entry name="finger" value="1"/>
    <entry name="continuous" value="2"/>
  </enum>

  <enum name="display_error_code">
    <entry name="protocol_violation" value="1"/>
    <entry name="version_unsupported" value="2"/>
    <entry name="negotiation_failed" value="3"/>
    <entry name="internal" value="4"/>
  </enum>

  <struct name="rgba_color">
    <field name="r" type="f32"/>
    <field name="g" type="f32"/>
    <field name="b" type="f32"/>
    <field name="a" type="f32"/>
  </struct>

  <struct name="display_metrics">
    <field name="width" type="u32"/>
    <field name="height" type="u32"/>
    <!-- Zero means the refresh rate is unknown. -->
    <field name="refresh_mhz" type="u32"/>
  </struct>

  <!--
    Flattened consumer DMA-BUF capabilities. The parallel arrays obey:
      mod_counts.len == fourccs.len
      modifiers.len == plane_counts.len == sum(mod_counts)
      device_uuid.len == driver_uuid.len == 4 (16 bytes packed as LE u32)

    drm_render=(0,0) and zero UUIDs mean unknown. The daemon then assumes
    a cross-GPU path and chooses conservative host-visible placement.
  -->
  <struct name="consumer_capabilities">
    <field name="fourccs" type="array" element="u32"/>
    <field name="mod_counts" type="array" element="u32"/>
    <field name="modifiers" type="array" element="u64"/>
    <field name="plane_counts" type="array" element="u32"/>
    <field name="device_uuid" type="array" element="u32"/>
    <field name="driver_uuid" type="array" element="u32"/>
    <field name="drm_render_major" type="u32"/>
    <field name="drm_render_minor" type="u32"/>
    <field name="mem_hints" type="u32"/>
    <field name="sync_caps" type="u32"/>
    <field name="color_caps" type="u32"/>
    <field name="extent_max_w" type="u32"/>
    <field name="extent_max_h" type="u32"/>
  </struct>

  <struct name="presentation_capabilities">
    <!--
      bit 0 = Pause Blur
      bit 1 = Fade Transition
      bit 2 = Wipe Transition
      bit 3 = Grow Transition
      All other bits are reserved and must be zero.
    -->
    <field name="flags" type="u32"/>
  </struct>

  <struct name="blur_effect_config">
    <field name="radius" type="u32"/>
  </struct>

  <struct name="pause_effect_config">
    <field name="kind" type="pause_effect_kind"/>
    <field name="blur" type="blur_effect_config"/>
  </struct>

  <struct name="pause_effect_state">
    <field name="active" type="bool"/>
  </struct>

  <!--
    Animation used when a bind replaces the presented wallpaper content.
    The daemon only names a kind the consumer declared in
    presentation_capabilities; every field carries a valid value even when
    kind is none.
      duration_ms: 100..=10000.
      angle: wipe direction in degrees, 0..=359, clockwise in surface
             space; 0 moves the edge left to right, 90 top to bottom.
      origin_x/origin_y: grow center in surface space, 0.0..=1.0.
  -->
  <struct name="transition_config">
    <field name="kind" type="transition_kind"/>
    <field name="duration_ms" type="u32"/>
    <field name="angle" type="u32"/>
    <field name="origin_x" type="f32"/>
    <field name="origin_y" type="f32"/>
  </struct>

  <struct name="presentation_config">
    <field name="generation" type="u64"/>
    <field name="pause_effect" type="pause_effect_config"/>
    <field name="transition" type="transition_config"/>
  </struct>

  <struct name="presentation_state">
    <field name="generation" type="u64"/>
    <field name="config_generation" type="u64"/>
    <field name="pause_effect" type="pause_effect_state"/>
  </struct>

  <struct name="presentation_snapshot">
    <field name="config" type="presentation_config"/>
    <field name="state" type="presentation_state"/>
  </struct>

  <struct name="composition_config">
    <field name="generation" type="u64"/>
    <field name="buffer_generation" type="u64"/>
    <field name="source_rect" type="rect"/>
    <field name="dest_rect" type="rect"/>
    <field name="transform" type="u32"/>
    <field name="clear_color" type="rgba_color"/>
  </struct>

  <!-- ==================================================================
       REQUESTS  (display -> daemon)
       ================================================================== -->

  <!-- Small version fence. Must be the first request. -->
  <request name="hello" opcode="1">
    <arg name="client_name" type="string"/>
    <arg name="client_version" type="string"/>
    <arg name="protocol_version" type="u32"/>
  </request>

  <!--
    Atomically register one output with all consumer-owned initial facts.
    `instance_id` is a stable opaque identifier; empty means settings fall
    back to the display name. `window_state_flags` uses WW_WIN_HAS_* bits.
  -->
  <request name="register_display" opcode="2">
    <arg name="name" type="string"/>
    <arg name="instance_id" type="string"/>
    <arg name="metrics" type="display_metrics"/>
    <arg name="consumer_caps" type="consumer_capabilities"/>
    <arg name="presentation_caps" type="presentation_capabilities"/>
    <arg name="window_state_flags" type="u32"/>
  </request>

  <!-- Complete replacement of current physical surface metrics. -->
  <request name="set_display_metrics" opcode="3">
    <arg name="metrics" type="display_metrics"/>
  </request>

  <!-- Request opcodes 4, 5 and 6 are reserved. -->

  <!--
    A configured import backend could not import one candidate generation.
    The daemon resolves format/modifier from its own binding state. `message`
    is diagnostic only; recovery policy is selected from the typed kind.
  -->
  <request name="buffer_import_failed" opcode="7">
    <arg name="buffer_generation" type="u64"/>
    <arg name="kind" type="buffer_import_failure_kind"/>
    <arg name="message" type="string"/>
  </request>

  <!--
    Pointer coordinates are actual surface-local pixels. `modifiers` uses:
      bit 0 Shift, bit 1 Ctrl, bit 2 Alt, bit 3 Super; bits 4..31 are zero.
    timestamp_us is CLOCK_MONOTONIC microseconds; zero means unavailable.
  -->
  <request name="pointer_motion" opcode="8">
    <arg name="x" type="f32"/>
    <arg name="y" type="f32"/>
    <arg name="timestamp_us" type="u64"/>
    <arg name="modifiers" type="u32"/>
  </request>

  <!-- `button` is a Linux input BTN_* code. -->
  <request name="pointer_button" opcode="9">
    <arg name="x" type="f32"/>
    <arg name="y" type="f32"/>
    <arg name="button" type="u32"/>
    <arg name="state" type="pointer_button_state"/>
    <arg name="timestamp_us" type="u64"/>
    <arg name="modifiers" type="u32"/>
  </request>

  <!-- delta_x/y are logical notches; diagonal scrolling is one request. -->
  <request name="pointer_axis" opcode="10">
    <arg name="x" type="f32"/>
    <arg name="y" type="f32"/>
    <arg name="delta_x" type="f32"/>
    <arg name="delta_y" type="f32"/>
    <arg name="source" type="pointer_axis_source"/>
    <arg name="timestamp_us" type="u64"/>
    <arg name="modifiers" type="u32"/>
  </request>

  <!-- Host accepted teardown ownership for this unbound generation. -->
  <request name="ack_unbind" opcode="11">
    <arg name="buffer_generation" type="u64"/>
  </request>

  <!-- Complete replacement of current daemon-side auto replay facts. -->
  <request name="set_window_state" opcode="12">
    <arg name="flags" type="u32"/>
  </request>

  <!-- The matching release syncobj now contains a fence or is signaled. -->
  <request name="frame_release_armed" opcode="13">
    <arg name="buffer_generation" type="u64"/>
    <arg name="seq" type="u64"/>
  </request>

  <!-- ==================================================================
       EVENTS  (daemon -> display)
       ================================================================== -->

  <event name="welcome" opcode="1">
    <arg name="server_version" type="string"/>
  </event>

  <!-- First normal event after register_display. -->
  <event name="display_accepted" opcode="2">
    <arg name="display_id" type="u64"/>
    <arg name="presentation" type="presentation_snapshot"/>
  </event>

  <!--
    Atomically publish one imported pool and its initial composition.
    The attached DMA-BUF fds are buffer-major, plane-minor. stride,
    plane_offset and size have count * planes_per_buffer entries.
    `transition` asks the consumer to animate from its presented content
    to this pool using the current presentation transition config. It is
    never set while that config's kind is none.
  -->
  <event name="bind_buffers" opcode="3">
    <arg name="buffer_generation" type="u64"/>
    <arg name="count" type="u32"/>
    <arg name="width" type="u32"/>
    <arg name="height" type="u32"/>
    <arg name="fourcc" type="u32"/>
    <arg name="modifier" type="u64"/>
    <arg name="planes_per_buffer" type="u32"/>
    <arg name="stride" type="array" element="u32"/>
    <arg name="plane_offset" type="array" element="u32"/>
    <arg name="size" type="array" element="u64"/>
    <arg name="initial_config" type="composition_config"/>
    <arg name="transition" type="bool"/>
    <fds count_expr="count * planes_per_buffer"/>
  </event>

  <!-- Composition-only update for the current buffer generation. It does
       not rebind the pool; the daemon schedules a current-content frame
       after publishing the new config. -->
  <event name="set_composition_config" opcode="4">
    <arg name="config" type="composition_config"/>
  </event>

  <!--
    One frame is available. Attached fds are acquire sync_file followed by
    the daemon-owned binary release syncobj.
  -->
  <event name="frame_ready" opcode="5">
    <arg name="buffer_generation" type="u64"/>
    <arg name="buffer_index" type="u32"/>
    <arg name="seq" type="u64"/>
    <fds count="2"/>
  </event>

  <!-- Retire the current generation without immediately publishing another. -->
  <event name="unbind" opcode="6">
    <arg name="buffer_generation" type="u64"/>
  </event>

  <event name="error" opcode="7">
    <arg name="code" type="display_error_code"/>
    <arg name="message" type="string"/>
  </event>

  <!-- Replace persistent presentation config and runtime state atomically. -->
  <event name="set_presentation_snapshot" opcode="8">
    <arg name="presentation" type="presentation_snapshot"/>
  </event>

  <!-- Complete runtime presentation state replacement. -->
  <event name="set_presentation_state" opcode="9">
    <arg name="state" type="presentation_state"/>
  </event>

</protocol>
